# web
web/node_modules/
web/dist/
web/*.tsbuildinfo
# wasm-pack build output (regenerated by `just build-wasm`)
web/crates/*/pkg/
# rust
web/crates/*/target/
target/

# api build artifacts live under api/.gitignore (generated by phx.new)

# local sqlite database (dev/test) — keep the dir, ignore the files
api/.tmp/*
!api/.tmp/.gitkeep

# nix / direnv
.direnv/
.nix-mix/
.nix-hex/
result
result-*

# misc
.DS_Store
*.log
